{
  "version": 2,
  "theme": {
    "id": "robotics",
    "label": "Robotique & Physical AI",
    "description": "Radar de catalyseurs sur la robotique, l'automatisation, les humanoïdes et leur chaîne de valeur.",
    "lookback_days": 90,
    "recent_days": 30,
    "subthemes": [
      {
        "id": "humanoids",
        "label": "Humanoïdes",
        "query": "(\"humanoid robot\" OR \"humanoid robotics\" OR \"dexterous robot\")",
        "keywords": [
          "humanoid",
          "dexterous robot",
          "biped",
          "robot hand",
          "robotics foundation model"
        ]
      },
      {
        "id": "industrial",
        "label": "Robotique industrielle & cobots",
        "query": "(\"industrial robot\" OR \"collaborative robot\" OR cobot OR \"robotics automation\")",
        "keywords": [
          "industrial robot",
          "collaborative robot",
          "cobot",
          "factory automation",
          "robot arm",
          "robotics automation"
        ]
      },
      {
        "id": "logistics",
        "label": "Logistique & AMR",
        "query": "(\"warehouse automation\" OR \"autonomous mobile robot\" OR \"mobile robotics\")",
