          "warehouse automation",
          "autonomous mobile robot",
          "mobile robot",
          "amr",
          "as/rs",
          "warehouse robot"
        ]
      },
      {
        "id": "motion",
        "label": "Motion control & actuateurs",
        "query": "(\"robot actuator\" OR \"harmonic drive\" OR \"precision reducer\" OR \"servo motor\" OR \"motion control\")",
