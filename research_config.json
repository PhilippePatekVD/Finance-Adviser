          "machine vision",
          "robot vision",
          "3d vision",
          "force torque sensor",
          "vision sensor",
          "camera inspection"
        ]
      },
      {
        "id": "physical_ai",
        "label": "Physical AI & embodied AI",
        "query": "(\"physical AI\" OR \"embodied AI\" OR \"robotics foundation model\" OR \"robot foundation model\")",
